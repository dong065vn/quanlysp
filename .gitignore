# Project-wide gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables (IMPORTANT: Never commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
*.env
product-manager/.env

# Testing
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# OS files
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Temporary files
tmp/
temp/
*.tmp

# Security alerts (generated files)
SECURITY_ALERT.md
