{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd product-manager && npm run build",
  "outputDirectory": "product-manager/dist",
  "installCommand": "cd product-manager && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
